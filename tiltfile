# Install Prometheus Operator
# helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
load('ext://helm_remote', 'helm_remote')
helm_remote('kube-prometheus-stack',  repo_url='https://prometheus-community.github.io/helm-charts', version='92.14.1',
            values=['./ops/dev-stack/monitoring/kube-prometheus-stack.values.yaml'])
k8s_resource("kube-prometheus-stack-prometheus-node-exporter", labels="prometheus")
k8s_resource("kube-prometheus-stack-grafana", port_forwards=[3000], labels="prometheus")
k8s_resource("kube-prometheus-stack-operator", labels="prometheus")
# Prometheus pods are created by the operator, not Tilt, so forward to the service directly
local_resource("prometheus-ui", serve_cmd="kubectl port-forward svc/kube-prometheus-stack-prometheus 9090:9090", resource_deps=["kube-prometheus-stack-operator"], labels="prometheus", links=["http://localhost:9090"])
k8s_resource("kube-prometheus-stack-kube-state-metrics", labels="prometheus")
k8s_resource("kube-prometheus-stack-admission-create", labels="prometheus")
k8s_resource("kube-prometheus-stack-admission-patch", labels="prometheus")

