# Customize Kubernetes resources
k8s_yaml(kustomize("./ops/dev-stack"))
k8s_resource('postgres-db', port_forwards=[5432], labels="psql_db")
k8s_resource('go-loader', port_forwards=[8000], labels="go_loader")

# Synthetic e-commerce traffic: Postgres writes (captured by Debezium) + clickstream to Redpanda
k8s_resource('shopgen', port_forwards=['8090:8000'], labels="shop", resource_deps=['postgres-db', 'redpanda'],
             links=[link('http://localhost:8090/status', 'generator status')])
# One-click incident injection for demos: watch them surface in RisingWave, Grafana and Argo
for incident in ['payment_outage', 'fraud_burst', 'traffic_spike']:
    local_resource('incident-' + incident.replace('_', '-'),
                   'curl -sf -X POST "localhost:8090/incident/%s?minutes=5"' % incident,
                   labels="shop", resource_deps=['shopgen'], trigger_mode=TRIGGER_MODE_MANUAL, auto_init=False)
