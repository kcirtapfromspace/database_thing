# Install Argo Cluster Workflows
k8s_yaml(helm('./ops/dev-stack/argo/helm/workflows'))
# Let Tilt inject locally built images into WorkflowTemplates (they have no pods of their own)
k8s_kind('WorkflowTemplate', image_json_path='{.spec.templates[?(@.container)].container.image}', pod_readiness='ignore')

# Event-driven pipeline: MinIO object events and RisingWave anomaly signals, routed over Redpanda
k8s_resource(new_name='event-pipeline', labels="event-driven",
             objects=['default:eventbus', 'lakehouse:eventsource', 'anomalies:eventsource',
                      'lakehouse-refresh:sensor', 'incident-response:sensor',
                      'argo-events-runner:serviceaccount', 'argo-events-runner:role',
                      'argo-events-runner:rolebinding'],
             resource_deps=['argo-events-controller-manager', 'redpanda', 'minio'])
k8s_resource('dbt-lakehouse', labels="event-driven")
k8s_resource('incident-response', labels="event-driven")

script = """\
CREATE_TOKEN="Bearer $(kubectl create token argo-workflows-server -n argo)"
echo $CREATE_TOKEN > ./.argo-token.txt
"""
local_resource("create-argo-server-token", script, resource_deps=["argo-workflows-server"],  labels="argo")

run_argo_workflow = """\
WF=$(kubectl -n argo create -o name -f - <<'EOF'
apiVersion: argoproj.io/v1alpha1
kind: Workflow
metadata:
  generateName: lakehouse-manual-
spec:
  workflowTemplateRef:
    name: dbt-lakehouse
EOF
)
echo "submitted $WF"
while :; do
  PHASE=$(kubectl -n argo get "$WF" -o jsonpath='{.status.phase}')
  case "$PHASE" in Succeeded|Failed|Error) break;; esac
  sleep 5
done
kubectl -n argo logs -l workflows.argoproj.io/workflow="${WF#*/}" -c main --prefix --tail=-1
echo "$WF finished: $PHASE"
test "$PHASE" = Succeeded
"""
local_resource("run-argo-workflow", run_argo_workflow, resource_deps=["argo-workflows-server", "create-argo-server-token"],  labels="argo", trigger_mode=TRIGGER_MODE_MANUAL, auto_init=False)

