# Install RisingWave: streaming SQL over the Redpanda topics (live funnel, payments, anomaly alerts)
namespace_create('risingwave')
helm_remote('risingwave', namespace='risingwave', repo_url='https://risingwavelabs.github.io/helm-charts/',
            version='0.2.60', values=['./ops/dev-stack/risingwave/values.yaml'])
k8s_resource('risingwave-standalone', port_forwards=['4566:4567'], labels="streaming", resource_deps=['minio'],
             links=[link('postgresql://root@localhost:4566/dev', 'psql (RisingWave)')])
k8s_resource('risingwave-ddl', labels="streaming", resource_deps=['risingwave-standalone', 'shopgen', 'dbz-connect'])

