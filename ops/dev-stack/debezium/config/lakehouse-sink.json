{
  "connector.class": "io.aiven.kafka.connect.s3.AivenKafkaConnectS3SinkConnector",
  "tasks.max": "1",
  "topics.regex": "cdc\\.shop\\..*|shop\\.clickstream",
  "aws.access.key.id": "minio",
  "aws.secret.access.key": "minio123",
  "aws.s3.bucket.name": "lakehouse",
  "aws.s3.endpoint": "http://minio.minio.svc.cluster.local:9000",
  "aws.s3.region": "us-east-1",
  "file.name.template": "raw/{{topic}}/{{partition:padding=true}}-{{start_offset:padding=true}}.parquet",
  "file.compression.type": "none",
  "format.output.type": "parquet",
  "format.output.fields": "value,offset,timestamp",
  "errors.log.enable": "true",
  "key.converter": "org.apache.kafka.connect.converters.ByteArrayConverter",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "http://redpanda-0.redpanda.kafka.svc.cluster.local:8081"
}
