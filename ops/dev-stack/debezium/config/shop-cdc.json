{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "postgres-db.default.svc.cluster.local",
  "database.port": "5432",
  "database.user": "postgres",
  "database.password": "postgres",
  "database.dbname": "postgres",
  "topic.prefix": "cdc",
  "schema.include.list": "shop",
  "plugin.name": "pgoutput",
  "slot.name": "shop_cdc",
  "publication.name": "shop_cdc_pub",
  "publication.autocreate.mode": "all_tables",
  "snapshot.mode": "initial",
  "decimal.handling.mode": "double",
  "time.precision.mode": "connect",
  "tombstones.on.delete": "false",
  "heartbeat.interval.ms": "10000",
  "errors.log.enable": "true",
  "key.converter": "io.confluent.connect.avro.AvroConverter",
  "key.converter.schema.registry.url": "http://redpanda-0.redpanda.kafka.svc.cluster.local:8081",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "http://redpanda-0.redpanda.kafka.svc.cluster.local:8081"
}
