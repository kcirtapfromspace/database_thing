    {
      "type": "bargauge",
      "title": "Funnel (sessions started 5-20 min ago)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "risingwave"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "risingwave"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Sessions\", count(*) FILTER (WHERE viewed_product) AS \"Viewed product\", count(*) FILTER (WHERE added_to_cart) AS \"Added to cart\", count(*) FILTER (WHERE started_checkout) AS \"Checkout\", count(*) FILTER (WHERE purchased) AS \"Purchased\" FROM mv_session_funnel WHERE started_at BETWEEN now() - INTERVAL '20 minutes' AND now() - INTERVAL '5 minutes'",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
