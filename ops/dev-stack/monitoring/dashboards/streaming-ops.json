    {
      "type": "timeseries",
      "title": "Redpanda: records / s by topic",
      "description": "Rate of change of each topic's high watermark",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (redpanda_topic) (rate(redpanda_kafka_max_offset{redpanda_topic=~\"cdc.*|shop.*|alerts.*\"}[2m]))",
          "legendFormat": "{{redpanda_topic}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
