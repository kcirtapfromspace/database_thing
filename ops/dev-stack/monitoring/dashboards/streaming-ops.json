    {
      "type": "timeseries",
      "title": "Clickstream events / min by type",
      "description": "shop.clickstream topic, aggregated by RisingWave in 1-minute tumbling windows",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "risingwave"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "risingwave"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, event_type AS metric, sum(events) AS value FROM mv_traffic_per_minute WHERE $__timeFilter(window_start) AND window_start < date_trunc('minute', now()) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
