# Debian slim Python: the Argo dbt-process-template runs this image via /bin/sh,
# and duckdb==0.9.2 only ships wheels up to Python 3.12
ARG PYTHON_VERSION=3.11

# Build stage
FROM python:${PYTHON_VERSION}-slim AS builder

WORKDIR /app

# Copy requirements first for better caching
COPY ./ops/dev-stack/dbt/requirements.txt .

# Install dependencies with pip
RUN pip install --no-cache-dir -r requirements.txt --user

# Final stage
FROM python:${PYTHON_VERSION}-slim AS final

ENV PYTHONIOENCODING=utf-8
ENV LANG=C.UTF-8
ENV PATH="/root/.local/bin:$PATH"

# Copy installed packages from builder
COPY --from=builder /root/.local /root/.local

# the lakehouse dbt project is baked in so event-triggered runs need no git clone or network;
# packages are vendored and the DuckDB httpfs extension is preinstalled
COPY ./ops/dev-stack/dbt/lakehouse_demo /opt/dbt/lakehouse
WORKDIR /opt/dbt/lakehouse
ENV DBT_PROFILES_DIR=/opt/dbt/lakehouse
RUN dbt deps && python -c "import duckdb; duckdb.sql('INSTALL httpfs')"

ENTRYPOINT ["dbt"]
